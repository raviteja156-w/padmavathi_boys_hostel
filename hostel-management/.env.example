# Copy this file to .env for local development and fill in real values.
# NEVER commit your actual .env file to version control.

# A long, random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Admin login credentials for the /admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Supabase Postgres connection string.
# Find it in Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Connection pooling" URI, port 6543, if your host recommends it)
# Example: postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-password@db.xxxxxxxx.supabase.co:5432/postgres

# Supabase Storage — for student profile photos (so they survive Render restarts).
# SUPABASE_URL: Project Settings -> API -> Project URL, e.g. https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> service_role key (SECRET — server-side only,
#   never expose this in frontend HTML/JS; keep it only as a Render/host environment variable).
# SUPABASE_STORAGE_BUCKET: name of the storage bucket used for photos (create it as "Public" bucket).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=student-photos

# Set to 1 to enable Flask debug mode locally. Leave unset (or 0) in production.
FLASK_DEBUG=0

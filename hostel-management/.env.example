# Copy this file to .env for local development and fill in real values.
# NEVER commit your actual .env file to version control.

# A long, random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Admin login credentials for the /admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Path to the SQLite database file.
# Locally this defaults to data/hostel.db
# On Render, point this to a path inside your mounted persistent disk, e.g. /var/data/hostel.db
DATABASE_PATH=data/hostel.db

# Set to 1 to enable Flask debug mode locally. Leave unset (or 0) in production.
FLASK_DEBUG=0

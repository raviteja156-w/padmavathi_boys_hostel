# EASIEST: run "python make_env.py" and it creates .env for you.
# Manual: copy this file to ".env", replace the placeholder values, keep no quotes and no spaces around "=".
# ".env" is git-ignored. On Render, enter these in Dashboard > Environment instead.

# Supabase "Session pooler" connection string with your real database password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Long random string (32+ characters). make_env.py generates this for you.
FLASK_SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters

# First administrator, created automatically on first start if no admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-12-chars-min
ADMIN_NAME=Administrator

# Use development when running on your own computer (http). Render uses production.
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
DAILY_TARGET_HOURS=4
SESSION_MAX_HOURS=16
DB_SSLMODE=require

# Optional GitHub integration
# Team repository shown to members (can also be set in the app: GitHub & data).
GITHUB_REPO_URL=
# Fine-grained token with "Pull requests: Read and write" + "Contents: Read and write" on the repo.
# When set, admins can merge pull requests from inside WorkPulse. Leave empty to merge on GitHub.
GITHUB_TOKEN=
GITHUB_MERGE_METHOD=merge
